{
  "expo": {
    "name": "IDHAM SCHEDULE",
    "slug": "idham-schedule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D90000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.idham.schedule",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "primaryColor": "#D90000",
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7d64c4bc-deaa-4e19-a336-1127c686df40"
      }
    }
  }
}
